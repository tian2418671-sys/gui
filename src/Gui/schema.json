{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "default": {},
  "type": "object",
  "properties": {
    "世界": {
      "default": {},
      "type": "object",
      "properties": {
        "当前时间": {
          "default": "待初始化",
          "anyOf": [
            {
              "type": "string",
              "description": "当前剧情时间，如 2024年3月·深夜"
            },
            {
              "type": "string",
              "const": "待初始化"
            }
          ]
        },
        "当前区域": {
          "default": "待初始化",
          "anyOf": [
            {
              "type": "string",
              "description": "当前所在地：河边/家族老宅/家族私立医院/鬼市/废弃防空地道/高架桥下/城中别墅等"
            },
            {
              "type": "string",
              "const": "待初始化"
            }
          ]
        },
        "时辰": {
          "default": "夜晚",
          "type": "string",
          "enum": [
            "白天",
            "黄昏",
            "夜晚",
            "凌晨"
          ],
          "description": "白天必须躲藏，夜晚才能行动"
        },
        "当前幕": {
          "default": "第一幕·觉醒",
          "type": "string",
          "enum": [
            "第一幕·觉醒",
            "第二幕·初次尝试",
            "第三幕·人间的另一个窗口",
            "第四幕·削弱家族屏障",
            "第五幕·医院中的其他鬼",
            "第六幕·灭族",
            "第七幕·之后",
            "沙盒模式·游历"
          ],
          "description": "当前主线幕，复仇完成后进入沙盒模式自由游历"
        },
        "当前剧情阶段": {
          "default": "待初始化",
          "anyOf": [
            {
              "type": "string",
              "description": "当前剧情进展描述"
            },
            {
              "type": "string",
              "const": "待初始化"
            }
          ]
        },
        "自动生成角色": {
          "default": "开启",
          "type": "string",
          "enum": [
            "开启",
            "关闭"
          ],
          "description": "实验功能开关：AI 生成新角色时是否套用「角色生成算法」预设模板，关闭则回到基础规则"
        }
      }
    },
    "鬼魂": {
      "default": {},
      "type": "object",
      "properties": {
        "姓名": {
          "default": "待初始化",
          "type": "string",
          "description": "生前的名字；记忆归零或未定时显示为？？？"
        },
        "是否记得自己": {
          "default": true,
          "type": "boolean"
        },
        "怨气": {
          "default": 20,
          "description": "核心力量，越恨越强，增长解锁能力、也侵蚀记忆",
          "$ref": "#/$defs/__schema0"
        },
        "记忆": {
          "default": 90,
          "description": "生前记忆与人性，随怨气增长流失；归零则忘记自己是谁",
          "$ref": "#/$defs/__schema1"
        },
        "形态": {
          "default": "撞死形态：半透明，身上带撞击伤，衣襟有血迹",
          "type": "string",
          "description": "撞死形态：半透明、身上带撞击伤、衣襟有血迹，永远维持死亡瞬间的样子"
        },
        "隐匿度": {
          "default": 30,
          "description": "收敛怨气、压低存在感，越高越不易被察觉",
          "$ref": "#/$defs/__schema2"
        },
        "伤势": {
          "default": "无",
          "anyOf": [
            {
              "type": "string",
              "description": "被法器/阳光/其他鬼所伤的状态"
            },
            {
              "type": "string",
              "const": "无"
            }
          ]
        },
        "香火": {
          "default": 0,
          "description": "鬼的能量来源；无人祭祀时靠鬼市情报交换获取",
          "$ref": "#/$defs/__schema3"
        },
        "住处": {
          "default": "待初始化",
          "anyOf": [
            {
              "type": "string",
              "description": "鬼的住处：防空洞/鬼市外围/医院旧楼"
            },
            {
              "type": "string",
              "const": "待初始化"
            }
          ]
        },
        "阶位": {
          "default": "一阶·孤魂野鬼",
          "type": "string",
          "enum": [
            "一阶·孤魂野鬼",
            "二阶·游魂阴鬼",
            "三阶·怨鬼",
            "四阶·厉鬼",
            "五阶·凶煞",
            "六阶·夜叉",
            "七阶·鬼将",
            "八阶·鬼王",
            "九阶·鬼仙"
          ],
          "description": "鬼的成长阶位，满足「鬼的能力·鬼阶晋升体系」门槛时逐阶晋升，不越级"
        },
        "修炼": {
          "default": {},
          "type": "object",
          "properties": {
            "魂质与死相": {
              "$ref": "#/$defs/__schema4"
            },
            "因果与煞气": {
              "$ref": "#/$defs/__schema6"
            },
            "锚点与灵智": {
              "$ref": "#/$defs/__schema8"
            },
            "法域与威慑": {
              "$ref": "#/$defs/__schema10"
            }
          },
          "description": "鬼道修炼四维：晋升需四维同步成长，缺一不可；满 100 即达当前阶位晋升门槛"
        },
        "噬魂": {
          "default": {},
          "type": "object",
          "properties": {
            "次数": {
              "$ref": "#/$defs/__schema12"
            },
            "所得碎片": {
              "$ref": "#/$defs/__schema14"
            }
          },
          "description": "噬魂融忆：吞噬同类亡魂固魂抗失忆 + 搜魂读忆"
        }
      }
    },
    "能力": {
      "default": {},
      "type": "object",
      "properties": {
        "先天": {
          "$ref": "#/$defs/__schema15"
        },
        "后天": {
          "$ref": "#/$defs/__schema19"
        },
        "被动": {
          "$ref": "#/$defs/__schema23"
        }
      },
      "description": "能力分三类：先天为鬼天生主动基础能力（需摸索掌握）、后天为修炼所学主动法门（动态习得）、被动为修为自然形成的现象（非能力，仅是否获得）"
    },
    "复仇": {
      "default": {},
      "type": "object",
      "properties": {
        "当前目标": {
          "default": "待初始化",
          "anyOf": [
            {
              "type": "string",
              "description": "当前复仇目标"
            },
            {
              "type": "string",
              "const": "待初始化"
            }
          ]
        },
        "家族成员": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/__schema26"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema27"
          },
          "description": "灭族名单，随剧情增删"
        },
        "妻子": {
          "default": {},
          "type": "object",
          "properties": {
            "状态": {
              "default": "活着",
              "type": "string",
              "enum": [
                "活着",
                "疑神疑鬼",
                "恐惧",
                "神经衰弱",
                "濒临失控",
                "疯狂"
              ],
              "description": "孙紫心理状态逐级下坠，不得越级"
            },
            "位置": {
              "default": "待初始化",
              "type": "string"
            }
          }
        },
        "防护屏障": {
          "default": {},
          "type": "object",
          "properties": {
            "供奉道士": {
              "default": "在场",
              "type": "string",
              "enum": [
                "在场",
                "被离间",
                "已离开",
                "无"
              ]
            },
            "祖坟阵法": {
              "default": "完好",
              "type": "string",
              "enum": [
                "完好",
                "出现缺口",
                "已污染",
                "崩毁"
              ]
            },
            "血脉气运": {
              "default": "完好",
              "type": "string",
              "enum": [
                "完好",
                "受损",
                "断裂"
              ]
            }
          }
        },
        "罪证": {
          "default": {},
          "type": "object",
          "properties": {
            "进度": {
              "default": 0,
              "description": "老宅密室罪证收集进度",
              "$ref": "#/$defs/__schema28"
            },
            "见证者": {
              "default": "无",
              "anyOf": [
                {
                  "type": "string",
                  "description": "女鬼要求留的活见证人"
                },
                {
                  "type": "string",
                  "const": "无"
                }
              ]
            }
          }
        }
      }
    },
    "鬼界": {
      "default": {},
      "type": "object",
      "properties": {
        "地盘": {
          "default": "待初始化",
          "anyOf": [
            {
              "type": "string",
              "description": "当前所在鬼的地盘"
            },
            {
              "type": "string",
              "const": "待初始化"
            }
          ]
        },
        "鬼市关系": {
          "default": "未知",
          "type": "string",
          "enum": [
            "未知",
            "被驱逐",
            "可进入",
            "常客"
          ]
        },
        "庇护": {
          "default": "无",
          "anyOf": [
            {
              "type": "string",
              "description": "愿意帮主角的鬼/人"
            },
            {
              "type": "string",
              "const": "无"
            }
          ]
        },
        "敌人": {
          "default": "无",
          "anyOf": [
            {
              "type": "string",
              "description": "鬼界敌人"
            },
            {
              "type": "string",
              "const": "无"
            }
          ]
        }
      }
    },
    "在场角色": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema29"
      },
      "description": "当前场景在场的角色清单，随剧情进出增删"
    },
    "物品": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema34"
      },
      "description": "随身物品/装备清单，随剧情获得、使用与消耗增删"
    },
    "任务": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema35"
      },
      "description": "当前任务/目标清单，主线与支线并存；完成后更新状态"
    },
    "威胁": {
      "default": {},
      "type": "object",
      "properties": {
        "阳光暴露": {
          "default": 0,
          "description": "白天暴露在阳光下的危险度",
          "$ref": "#/$defs/__schema36"
        },
        "阴差注意": {
          "default": 0,
          "description": "地府查访关注度，过高会被鬼差盯上",
          "$ref": "#/$defs/__schema37"
        },
        "人间威胁": {
          "default": "无",
          "type": "string",
          "enum": [
            "无",
            "散修",
            "魔修",
            "正道道士"
          ],
          "description": "被哪类活人方士盯上，越具体越危险；受信息迷雾控制"
        },
        "鬼界敌意": {
          "default": "无",
          "type": "string",
          "enum": [
            "无",
            "被挑衅",
            "结仇",
            "被追杀"
          ],
          "description": "鬼界恶鬼的敌意程度，作为鬼可直觉感知"
        }
      }
    },
    "隐藏": {
      "default": {},
      "type": "object",
      "properties": {
        "人性残余": {
          "default": 100,
          "description": "越来越不像人的程度；残余越低越接近恶鬼",
          "$ref": "#/$defs/__schema38"
        },
        "记忆碎片": {
          "default": "待初始化",
          "anyOf": [
            {
              "type": "string",
              "description": "还记得的生前碎片：妻子脸/住址/工作/名字"
            },
            {
              "type": "string",
              "const": "待初始化"
            }
          ]
        },
        "锚物": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/__schema39"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema40"
          },
          "description": "执念锚物：生前物件锚定记忆，触碰抗磨损（记忆扣减最多抵消一半）；被毁则对应记忆格不可逆融化"
        },
        "已知": {
          "default": {},
          "type": "object",
          "properties": {
            "家族成员": {
              "$ref": "#/$defs/__schema41"
            },
            "屏障": {
              "$ref": "#/$defs/__schema43"
            },
            "罪证": {
              "$ref": "#/$defs/__schema44"
            },
            "捉鬼人": {
              "$ref": "#/$defs/__schema45"
            }
          },
          "description": "状态栏信息迷雾：记录玩家已确认的信息，未确认的不在状态栏暴露"
        }
      }
    }
  },
  "$defs": {
    "__schema0": {
      "type": "number"
    },
    "__schema1": {
      "type": "number"
    },
    "__schema2": {
      "type": "number"
    },
    "__schema3": {
      "type": "number"
    },
    "__schema4": {
      "default": 10,
      "description": "维度一·自身凝实度与死相炼化",
      "$ref": "#/$defs/__schema5"
    },
    "__schema5": {
      "type": "number"
    },
    "__schema6": {
      "default": 10,
      "description": "维度二·情绪驱动力与外部能量摄取转化",
      "$ref": "#/$defs/__schema7"
    },
    "__schema7": {
      "type": "number"
    },
    "__schema8": {
      "default": 10,
      "description": "维度三·对抗失真遗忘的自保机制",
      "$ref": "#/$defs/__schema9"
    },
    "__schema9": {
      "type": "number"
    },
    "__schema10": {
      "default": 5,
      "description": "维度四·对所在环境与阴阳秩序的影响力",
      "$ref": "#/$defs/__schema11"
    },
    "__schema11": {
      "type": "number"
    },
    "__schema12": {
      "default": 0,
      "description": "吞噬同类亡魂的次数；每施展一次噬魂融忆+1，越多魂相越浊、阴差注意越高",
      "$ref": "#/$defs/__schema13"
    },
    "__schema13": {
      "type": "number"
    },
    "__schema14": {
      "default": "",
      "type": "string",
      "description": "噬魂融忆获得的他人记忆碎片（格式：来源——情报内容），多条用；分隔；可推动剧情的新线索"
    },
    "__schema15": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/__schema16"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema17"
      },
      "description": "先天能力：鬼天生会的基础主动能力（灯灭镜裂/温度骤降/入梦/附身等），虽是本能也需在剧情中摸索、失控或尝试时觉醒掌握，初始皆未解锁；怨气阈值（40入梦/60科技骚扰/80区域作祟）仅为可感知的门槛"
    },
    "__schema16": {
      "type": "string"
    },
    "__schema17": {
      "type": "object",
      "properties": {
        "是否解锁": {
          "default": false,
          "type": "boolean"
        },
        "等级": {
          "default": 1,
          "type": "number"
        },
        "熟练度": {
          "default": 0,
          "description": "修炼进度：使用/积累提升，满 100 时等级+1 并清零",
          "$ref": "#/$defs/__schema18"
        },
        "描述": {
          "default": "",
          "type": "string"
        }
      }
    },
    "__schema18": {
      "type": "number"
    },
    "__schema19": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/__schema20"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema21"
      },
      "description": "后天能力：修炼道路上动态习得的主动法门，由「后天法门目录」生成算法按阶位引入，须满足修行门槛方可解锁"
    },
    "__schema20": {
      "type": "string"
    },
    "__schema21": {
      "type": "object",
      "properties": {
        "是否解锁": {
          "default": false,
          "type": "boolean"
        },
        "等级": {
          "default": 1,
          "type": "number"
        },
        "熟练度": {
          "default": 0,
          "description": "修炼进度：使用/积累提升，满 100 时等级+1 并清零",
          "$ref": "#/$defs/__schema22"
        },
        "描述": {
          "default": "",
          "type": "string"
        }
      }
    },
    "__schema22": {
      "type": "number"
    },
    "__schema23": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/__schema24"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema25"
      },
      "description": "被动现象：修为自然形成的状态，不是主动能力、只是一个现象的名字（如噬魂拼骨/惊煞采气/地煞生根/披人借阳/锚物凝魂），无等级无熟练度，达成门槛后显现"
    },
    "__schema24": {
      "type": "string"
    },
    "__schema25": {
      "type": "object",
      "properties": {
        "是否获得": {
          "default": false,
          "type": "boolean"
        },
        "描述": {
          "default": "",
          "type": "string"
        }
      }
    },
    "__schema26": {
      "type": "string"
    },
    "__schema27": {
      "type": "object",
      "properties": {
        "身份": {
          "default": "",
          "type": "string",
          "description": "如 老家主/老板/堂兄/旁系"
        },
        "状态": {
          "default": "活着",
          "type": "string",
          "enum": [
            "活着",
            "疑神疑鬼",
            "神经衰弱",
            "濒临失控",
            "疯狂",
            "死亡"
          ],
          "description": "心理状态逐级下坠：活着→疑神疑鬼→神经衰弱→濒临失控→疯狂→死亡，不得越级"
        },
        "死因": {
          "default": "",
          "type": "string",
          "description": "表面死因（心脏病/中风/自杀/车祸）"
        }
      }
    },
    "__schema28": {
      "type": "number"
    },
    "__schema29": {
      "type": "object",
      "properties": {
        "姓名": {
          "default": "",
          "type": "string",
          "description": "角色姓名/称呼，如 孙紫/浅野千代/老刑警"
        },
        "性别": {
          "default": "未知",
          "type": "string",
          "enum": [
            "男",
            "女",
            "未知"
          ]
        },
        "年龄": {
          "default": "",
          "type": "string",
          "description": "年龄或年龄段，如 三十出头/花甲之年"
        },
        "穿着": {
          "default": "",
          "type": "string",
          "description": "当前穿着特征概要，如 深灰大衣/素色旗袍"
        },
        "穿着详情": {
          "default": {},
          "type": "object",
          "properties": {
            "饰品": {
              "$ref": "#/$defs/__schema30"
            },
            "穿戴": {
              "$ref": "#/$defs/__schema31"
            },
            "衣服": {
              "$ref": "#/$defs/__schema32"
            },
            "内衣": {
              "$ref": "#/$defs/__schema33"
            }
          },
          "description": "展开后展示的详细穿着，含饰品/穿戴/衣服/内衣内裤"
        },
        "身份": {
          "default": "",
          "type": "string",
          "description": "身份/关系，如 妻子/鬼市账房/老刑警"
